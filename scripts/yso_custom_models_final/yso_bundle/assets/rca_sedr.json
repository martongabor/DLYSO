{
  "task": "binary_yso_vs_other",
  "product": "sedr",
  "product_dir": "SEDrplot",
  "model": "rca",
  "arch": "ResConvAttnClassifier",
  "class_to_idx": {
    "other": 0,
    "YSO": 1
  },
  "probability": "sigmoid(logit)",
  "preprocess": {
    "target_size": [
      190,
      190
    ],
    "as_gray": true,
    "normalize_01": true,
    "invert": false,
    "binarize": false
  },
  "model_kwargs": {
    "in_channels": 1,
    "num_classes": 1,
    "inner_channel": 16,
    "channel_mults": [
      1,
      2,
      4,
      8,
      8
    ],
    "res_blocks": 2,
    "attn_ds": [
      8,
      16,
      32
    ],
    "dropout": 0.15,
    "num_heads": 2,
    "use_conv_skip": false,
    "layerscale_init": 0.01,
    "head": "mlp",
    "head_hidden": 256,
    "head_dropout": 0.15
  },
  "asset_state_dict": "rca_sedr.pt"
}